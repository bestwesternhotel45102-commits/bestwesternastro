---
// src/pages/index.astro
// MIGRATION of /index.html — metadata, canonical, JSON-LD schema, body copy,
// headings, and internal links preserved VERBATIM. Shared chrome
// (nav / mobile menu / footer / scroll-top + burger script) is provided by
// BaseLayout; page-specific <style>/schema go in the head slot and
// page-specific scripts in the scripts slot, both emitted unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import { hotelNodeFull, hotelRef, ldScript } from '../data/schema.ts';
import { RATES, usd, LOWEST_NIGHTLY, WEEKLY_CALL_LINE } from '../data/rates.ts';
import { BUSINESS } from '../data/business.ts';
import { HERO_SLIDES } from '../data/heroShowcase.ts';
// The gallery grid AND its lightbox both render from this one array. They used
// to be two hand-kept lists linked by index, and the indices no longer agreed —
// every room tile opened a different photograph. See the note in the file.
import { HOME_GALLERY } from '../data/homeGallery.ts';
// Detailed room pages (/rooms/*). Slugs live in rooms.ts, so the links below
// and the pages themselves can never drift apart.
import { roomBySlideId, roomHref, ROOMS } from '../data/rooms.ts';
// The "Every Room Feels Like Home" tabs. This section used to be ~320 lines of
// hand-written markup showing CGI renders of rooms the hotel does not sell —
// see the header of the file for what had gone wrong with it.
import { ROOM_TABS } from '../data/homeRoomTabs.ts';

/** Root-relative link to a room's detail page, by its hero-reel slide id. */
const slideRoomHref = (slideId: string): string | null => {
  const r = roomBySlideId(slideId);
  return r ? roomHref(r.slug) : null;
};
/** Root-relative link to a room's detail page, by its rate-card name. */
const nameRoomHref = (name: string): string | null => {
  const r = ROOMS.find((x) => x.name === name);
  return r ? roomHref(r.slug) : null;
};
/** Rate-table room-name cell: a link where a detail page exists, plain text
 *  otherwise (a room type with no page of its own, e.g. the Studio King
 *  (Kitchenette) and Studio Jacuzzi Two Queen rows). */
const rateCell = (name: string): string => {
  const href = nameRoomHref(name);
  return href
    ? `<a href="${href}" style="color:var(--navy);font-weight:700;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),.65);">${name}</a>`
    : `<strong>${name}</strong>`;
};

/* ── Escaping, for the room-tab copy in src/data/homeRoomTabs.ts ───────────────
 * That file holds prose, not markup: a pill reads "Fridge & Freezer" and a
 * caption may contain an apostrophe. Three small helpers put it into HTML.   */

/** Bare "&" → "&amp;", leaving existing entities and the `<br>`/`<em>` in the
 *  headlines alone. */
const amp = (s: string): string => s.replace(/&(?![a-zA-Z#][a-zA-Z0-9]*;)/g, '&amp;');
/** For an attribute value delimited by double quotes. */
const attr = (s: string): string => amp(s).replace(/"/g, '&quot;');
/** For a single-quoted JS string argument inside a double-quoted onclick — the
 *  lightbox captions are full sentences and several contain an apostrophe. */
const jsArg = (s: string): string =>
  attr(s.replace(/\\/g, '\\\\').replace(/'/g, "\\'"));

const hotelDescription = `Newly renovated Best Western Vernal Hotel in Vernal, Utah. Nightly rates from ${LOWEST_NIGHTLY} + tax; weekly rates available — call for price. Free hot breakfast daily, full kitchenettes, jacuzzi studios, pet friendly rooms, and heated floors in the dining room.`;

const headExtras = `<!-- The reel's opening photograph is the largest thing above the fold and was
     queueing behind 28 other images; measured on an 8 Mbps connection it did not
     paint for 3.5s, so the hero sat blank while the reel counted down. -->
<link rel="preload" as="image" href="${HERO_SLIDES[0].image}" media="(min-aspect-ratio: 3/4)" fetchpriority="high">${HERO_SLIDES[0].portrait ? `
<link rel="preload" as="image" href="${HERO_SLIDES[0].portrait}" media="(max-aspect-ratio: 3/4)" fetchpriority="high">
<style>@media (max-aspect-ratio: 3/4){#hero .hero-slide:first-of-type .hero-kb{background-image:url('${HERO_SLIDES[0].portrait}')!important}}</style>` : ''}
${ldScript(hotelNodeFull(hotelDescription))}
<script type="application/ld+json">
 {
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": [
 {
 "@type": "ListItem",
 "position": 1,
 "name": "Home",
 "item": "https://bestwesternvernalhotel.com/"
 }
 ]
 }
 </script>
<script type="application/ld+json">
 {
 "@context": "https://schema.org",
 "@type": "Person",
 "name": "Paresh Ghandi",
 "jobTitle": "Owner / Manager",
 "description": "Local Vernal owner of Best Western Vernal Hotel, committed to warm hospitality in the Uintah Basin.",
 "url": "https://bestwesternvernalhotel.com/video",
 "worksFor": ${JSON.stringify(hotelRef())}
 }
 </script>
<script type="application/ld+json">
 {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
 {
 "@type": "Question",
 "name": "What are the weekly rates at Best Western Vernal Hotel?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Weekly rates are quoted by phone — call (435) 789-6625 for current weekly pricing. Published nightly rates start at ${LOWEST_NIGHTLY} + tax for a Studio King. Monthly rates and corporate billing for long-term stays are also available by phone."
 }
 },
 {
 "@type": "Question",
 "name": "Is Best Western Vernal Hotel pet friendly?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Yes. Up to two dogs per room, 80 lb limit per dog. Pet fee is $30/day plus a $100 refundable deposit at check-in. Other pets may be approved with prior notice — call (435) 789-6625."
 }
 },
 {
 "@type": "Question",
 "name": "Does Best Western Vernal Hotel include free breakfast?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Yes. A free hot breakfast is included every day — hot dishes, pancakes, pastries, fruit, juice, and coffee. No extra charge, served daily."
 }
 },
 {
 "@type": "Question",
 "name": "Do the rooms have kitchenettes?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Most rooms include a full kitchenette with stovetop, microwave, full-size refrigerator, and coffee maker — ideal for longer stays and long-term guests."
 }
 },
 {
 "@type": "Question",
 "name": "How far is Best Western Vernal Hotel from Dinosaur National Monument?",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "Dinosaur National Monument is approximately 20 minutes from Best Western Vernal Hotel at 1935 South 1500 East, Vernal, UT 84078."
 }
 }
 ]
 }
 </script>
<style>
 /* Page Summary Bar */
 .page-summary-bar {
 position: absolute;
 width: 1px;
 height: 1px;
 padding: 0;
 margin: -1px;
 overflow: hidden;
 clip: rect(0,0,0,0);
 white-space: nowrap;
 border: 0;
 }

 /* Badge styles moved to styles.css */

 /* ── "Leave a Google review" button, under the guest quote (.quote) ──
    Navy-dark pill with a gold hairline, matching the hero rate card; white
    Google "G", five stars that turn gold one after another on hover/focus, a
    periodic shine sweep, a soft gold halo and a star burst on click (script in
    pageScripts). All motion is off under prefers-reduced-motion. */
 .bw-review-cta {
 display: flex;
 flex-direction: column;
 align-items: center;
 gap: 14px;
 max-width: 460px;
 margin: 34px auto 0;
 padding-top: 28px;
 border-top: 1px solid rgba(var(--gold-rgb), .3);
 }
 .bw-review-cta__prompt {
 margin: 0;
 font-family: 'Playfair Display', serif;
 font-style: italic;
 font-size: 1.05rem;
 line-height: 1.5;
 color: rgba(var(--cream-rgb), .92);
 text-wrap: balance;
 }
 .bw-review-btn {
 position: relative;
 display: inline-flex;
 align-items: center;
 gap: 10px;
 max-width: 100%;
 padding: 10px 20px 10px 10px;
 border: 1px solid rgba(var(--gold-rgb), .7);
 border-radius: 999px;
 background: linear-gradient(160deg, rgba(var(--navy-dark-rgb), .78), rgba(var(--navy-dark-rgb), .96));
 color: #fff;
 font-family: 'Lato', sans-serif;
 font-weight: 900;
 font-size: .8rem;
 letter-spacing: 1.4px;
 text-transform: uppercase;
 text-decoration: none;
 box-shadow: 0 6px 18px rgba(0, 0, 0, .28), inset 0 1px 0 rgba(var(--white-rgb), .12);
 isolation: isolate;
 transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
 }
 /* Shine sweep, clipped to the pill by its radius. */
 .bw-review-btn::before {
 content: "";
 position: absolute;
 inset: 0;
 border-radius: inherit;
 background: linear-gradient(110deg, transparent 30%, rgba(var(--gold-rgb), .35) 50%, transparent 70%) no-repeat;
 background-size: 250% 100%;
 background-position: 150% 0;
 z-index: -1;
 pointer-events: none;
 }
 /* Soft pulsing halo to draw the eye. */
 .bw-review-btn::after {
 content: "";
 position: absolute;
 inset: -4px;
 border-radius: inherit;
 border: 2px solid rgba(var(--gold-rgb), .7);
 opacity: 0;
 z-index: -2;
 pointer-events: none;
 }
 .bw-review-btn__g {
 display: grid;
 place-items: center;
 width: 32px;
 height: 32px;
 flex: 0 0 32px;
 border-radius: 50%;
 background: #fff;
 box-shadow: 0 1px 3px rgba(0, 0, 0, .25);
 transition: transform .4s cubic-bezier(.34, 1.56, .64, 1);
 }
 .bw-review-btn__g svg { display: block; }
 .bw-review-btn__stars {
 display: inline-flex;
 gap: 1px;
 font-size: .95rem;
 letter-spacing: 0;
 }
 .bw-review-btn__stars i {
 font-style: normal;
 color: rgba(var(--white-rgb), .35);
 transition: color .2s ease, transform .25s cubic-bezier(.34, 1.56, .64, 1);
 }
 .bw-review-btn:hover,
 .bw-review-btn:focus-visible {
 transform: translateY(-2px);
 border-color: var(--gold);
 box-shadow: 0 10px 26px rgba(0, 0, 0, .35), 0 0 0 1px rgba(var(--gold-rgb), .35), inset 0 1px 0 rgba(var(--white-rgb), .12);
 }
 .bw-review-btn:focus-visible { outline: 3px solid var(--gold-light); outline-offset: 4px; }
 .bw-review-btn:active { transform: translateY(0) scale(.97); }
 .bw-review-btn:hover .bw-review-btn__g,
 .bw-review-btn:focus-visible .bw-review-btn__g { transform: rotate(-12deg) scale(1.1); }
 /* Stars light up one after another on hover/focus. */
 .bw-review-btn:hover .bw-review-btn__stars i,
 .bw-review-btn:focus-visible .bw-review-btn__stars i {
 color: var(--gold-light);
 transform: scale(1.25);
 }
 .bw-review-btn__stars i:nth-child(2) { transition-delay: .06s; }
 .bw-review-btn__stars i:nth-child(3) { transition-delay: .12s; }
 .bw-review-btn__stars i:nth-child(4) { transition-delay: .18s; }
 .bw-review-btn__stars i:nth-child(5) { transition-delay: .24s; }
 /* Star burst on click. */
 .bw-review-btn__spark {
 position: absolute;
 left: 50%;
 top: 50%;
 color: var(--gold-light);
 font-size: 14px;
 line-height: 1;
 letter-spacing: 0;
 pointer-events: none;
 text-shadow: 0 0 6px rgba(var(--gold-rgb), .7);
 animation: bw-review-spark .7s ease-out forwards;
 }
 @keyframes bw-review-spark {
 from { transform: translate(-50%, -50%) scale(.6); opacity: 1; }
 to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.1) rotate(180deg); opacity: 0; }
 }
 @media (prefers-reduced-motion: no-preference) {
 .bw-review-btn::before { animation: bw-review-shine 4s ease-in-out 1.5s infinite; }
 .bw-review-btn::after { animation: bw-review-halo 2.8s ease-out infinite; }
 .bw-review-btn:hover::before { animation-duration: 1.2s; animation-delay: 0s; }
 }
 @keyframes bw-review-shine {
 0%, 60% { background-position: 150% 0; }
 100% { background-position: -50% 0; }
 }
 @keyframes bw-review-halo {
 0% { transform: scale(.96); opacity: .8; }
 100% { transform: scale(1.12); opacity: 0; }
 }
 @media (prefers-reduced-motion: reduce) {
 .bw-review-btn,
 .bw-review-btn__g,
 .bw-review-btn__stars i { transition: none; }
 .bw-review-btn:hover,
 .bw-review-btn:focus-visible,
 .bw-review-btn:active,
 .bw-review-btn:hover .bw-review-btn__g,
 .bw-review-btn:focus-visible .bw-review-btn__g,
 .bw-review-btn:hover .bw-review-btn__stars i,
 .bw-review-btn:focus-visible .bw-review-btn__stars i { transform: none; }
 }
 @media (max-width: 420px) {
 .bw-review-btn { font-size: .74rem; letter-spacing: 1px; padding: 9px 16px 9px 9px; gap: 8px; }
 .bw-review-btn__stars { display: none; }
 }
 </style>`;
const bodyContent = `

<!-- ═══════════════════════════════════════════════════════════ -->

<!-- PAGE SUMMARY BAR — AI-extractable content, visible to all crawlers -->
<div class="page-summary-bar" role="complementary" aria-label="Quick summary">
 <strong>Best Western Vernal Hotel</strong> — Hotel in Vernal, Utah. Nightly rates from ${LOWEST_NIGHTLY} + tax (Studio King). Weekly rates — call for price. Free hot breakfast daily, full kitchenettes, jacuzzi studios, pet friendly rooms, free WiFi and free parking. Located at 1935 South 1500 East, Vernal, UT 84078 — 0.6 miles from Vernal Regional Airport, near Dinosaur National Monument. Book online at BestWestern.com or call <strong>(435) 789-6625</strong>.
</div>

<!-- NAV -->


<!-- HERO SLIDESHOW — cinematic Ken Burns backgrounds.
     Opens on the two property shots, then walks one room type per slide with
     its rate laid over the photograph, and closes on the pool, hot tub and
     fitness center. Slides and rates both come from
     src/data/heroShowcase.ts → src/data/rates.ts; nothing is hardcoded here. -->
<section class="hero" id="hero" aria-roledescription="carousel" aria-label="Best Western Vernal Hotel — rooms and rates">
${HERO_SLIDES.map((s, i) => `<div class="hero-slide ${s.kb}${i === 0 ? ' active' : ''}" role="img" aria-label="${s.alt}"><div class="hero-kb"${i === 0 ? ` style="background-image:url('${s.image}')"` : ` data-bg="${s.image}"`}${s.portrait ? ` data-bg-portrait="${s.portrait}"` : ''}></div></div>`).join('\n')}
 <div class="hero-ov"></div>
 <div class="hero-cnt">
 <p class="eyebrow">Now Open in Vernal, Utah</p>
 <h1 class="htitle">Best Western<br><em>Vernal Hotel</em></h1>
 <p class="hsub">Spacious rooms, free hot breakfast, and a warm welcome every single day. Your home away from home.</p>
 <div class="hbtns">
 <a href="${BUSINESS.bookingUrl}" class="btn-p" data-track="book_click">${BUSINESS.directBooking.ctaLabel}</a>
 <a href="#rooms" class="btn-s">Explore Rooms</a>
 </div>
 </div>

 <!-- ROOM RATE RIBBON — one panel per room slide, cross-faded in step with the
      photo. It sits at the foot of the hero column rather than floating in a
      corner: .pet-badge sits over the right edge, and a corner card is
      unreadable on any laptop-height screen. Three blocks on desktop, stacked
      on phones. -->
 <div class="hroom-layer" id="hroom-layer">
${HERO_SLIDES.map((s, i) => {
  if (!s.room) return '';
  const r = s.room;
  // Link the slide to its detailed room page. Inline-styled rather than given a
  // new global class: the brief is to link the existing reel, not restyle it.
  const href = slideRoomHref(s.id);
  const more = href
    ? `<a href="${href}" class="hroom-more" style="display:inline-block;margin-top:8px;color:var(--gold);font-size:.72rem;letter-spacing:1.2px;text-transform:uppercase;font-weight:700;text-decoration:none;border-bottom:1px solid rgba(var(--gold-rgb),.5);padding-bottom:2px;">View room details →</a>`
    : '';
  const rate = r.nightly.published
    ? `<p class="hroom-rate">${r.nightly.qualifier ? `<span class="hroom-from">${r.nightly.qualifier}</span>` : ''}<span class="hroom-amt">${r.nightly.price}</span><span class="hroom-per">/ night</span></p>`
    : `<p class="hroom-rate hroom-rate--call"><span class="hroom-amt hroom-amt--call">${r.nightly.price}</span></p>`;
  return ` <article class="hroom" data-slide="${i}" aria-hidden="true">
   <div class="hroom-id">
    <p class="hroom-kicker">${r.sleeps}</p>
    <h2 class="hroom-name">${r.name}</h2>
    <ul class="hroom-feats">${r.features.map((f) => `<li>${f}</li>`).join('')}</ul>
   </div>
   <div class="hroom-price">
    ${rate}
    <p class="hroom-fine">${r.nightly.note}</p>
   </div>
   <div class="hroom-act">
    <p class="hroom-weekly">${r.weekly}</p>
    ${r.footnote ? `<p class="hroom-foot">${r.footnote}</p>` : ''}
    <a href="${BUSINESS.bookingUrl}" class="hroom-cta" data-track="book_click">${BUSINESS.directBooking.ctaLabel}</a>
    ${more}
   </div>
  </article>`;
}).join('\n')}
 </div>

 <!-- Controls sit as one row at the bottom centre: the left edge of the hero is
      right edge of the hero is taken by the pet badge, which would swallow a
      vertically-centred arrow. -->
 <div class="hctrls">
  <button class="hnav" id="hprev" type="button" aria-controls="hero" aria-label="Previous slide">‹</button>
  <div class="hdots" id="hdots" role="tablist" aria-label="Choose a room"></div>
  <button class="hnav" id="hnext" type="button" aria-controls="hero" aria-label="Next slide">›</button>
 </div>
 <div class="scroll-hint">Scroll</div>

 <!-- PET FRIENDLY BADGE -->
 <a href="#rooms" onclick="st(document.querySelector('[onclick*=pet]'),'pet')" class="pet-badge">
 <div class="pet-badge-img">
 <img src="images/puppy.webp" alt="Pet Friendly Hotel Vernal Utah — Dogs Welcome at Best Western Vernal Hotel">
 </div>
 <div class="pet-badge-footer">
 <span class="pet-paw-icon">🐾</span>
 <div class="pet-badge-words">
 <span class="pet-label">Pet Friendly</span>
 <span class="pet-sub">Dogs Welcome</span>
 </div>
 </div>
 </a>

</section>

<!-- PERKS BAR -->
<div class="pbar rv">
 <div class="pi"><span class="ic">🍳</span><div><div class="label">Free Breakfast</div><div class="sub">Hot &amp; fresh every morning</div></div></div>
 <div class="pi"><span class="ic">📶</span><div><div class="label">Free WiFi</div><div class="sub">Fast in every room</div></div></div>
 <div class="pi"><span class="ic">🅿️</span><div><div class="label">Free Parking</div><div class="sub">Always on us</div></div></div>
 <div class="pi"><span class="ic">🍴</span><div><div class="label">Full Kitchenettes</div><div class="sub">Cook your own meals</div></div></div>
 <div class="pi"><span class="ic">🕐</span><div><div class="label">24-Hr Front Desk</div><div class="sub">Always here for you</div></div></div>
 <div class="pi"><span class="ic">🐾</span><div><div class="label">Pet Friendly</div><div class="sub">Whole family welcome</div></div></div>
</div>

<!-- BOOK DIRECT -->
<section style="background:var(--navy);color:#fff;padding:40px 20px;text-align:center;">
 <p style="font-size:.75rem;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:10px;">Book Direct with Best Western</p>
 <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.4rem,3.5vw,2rem);margin-bottom:12px;">Skip Third-Party Booking Sites</h2>
 <p style="opacity:.85;max-width:520px;margin:0 auto 20px;line-height:1.6;">Reserve your room on BestWestern.com, or call the front desk — we're here 24 hours.</p>
 <a href="${BUSINESS.bookingUrl}" data-track="book_click" style="display:inline-block;background:var(--gold);color:var(--navy);padding:13px 32px;border-radius:4px;text-decoration:none;font-weight:900;font-size:.85rem;letter-spacing:1.5px;text-transform:uppercase;">${BUSINESS.directBooking.ctaLabel}</a>
 <a href="tel:${BUSINESS.phoneTel}" data-track="phone_call_homepage" style="display:inline-block;margin-left:10px;border:2px solid var(--gold);color:var(--gold);padding:11px 30px;border-radius:4px;text-decoration:none;font-weight:900;font-size:.85rem;letter-spacing:1.5px;text-transform:uppercase;">📞 ${BUSINESS.phoneDisplay}</a>
</section>

<!-- WHY BOOK DIRECT -->
<section style="background:var(--cream);padding:36px 20px;text-align:center;">
 <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.2rem,3vw,1.6rem);color:var(--navy);margin-bottom:18px;">Why Book Direct?</h2>
 <ul style="list-style:none;padding:0;margin:0 auto;max-width:560px;display:flex;flex-direction:column;gap:12px;text-align:left;">
  <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--gold);font-weight:900;">✓</span> No third-party booking fees</li>
  <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--gold);font-weight:900;">✓</span> Speak directly with our front desk staff</li>
  <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:var(--gold);font-weight:900;">✓</span> Get answers about rooms, pets, parking, and local attractions before you book</li>
 </ul>
</section>

<!-- WEEKLY RATES -->
<section class="weekly-rates rv">
 <div class="wr-inner">
 <p class="wr-eyebrow">✦ Weekly Stay Savings ✦</p>
 <h2 class="wr-title">Special <em>Weekly Rates</em></h2>
 <p class="wr-sub">Staying 7 nights or longer? Weekly rates are quoted by the front desk — call and we'll give you the current price for your dates and room type.</p>
 <div class="wr-cards">
 <div class="wr-card">
 <div class="wr-icon">🛏️</div>
 <div class="wr-type">Studio King</div>
 <div class="wr-price wr-price-call">Call for Price</div>
 <div class="wr-period">7-night weekly rate</div>
 <a href="tel:${BUSINESS.phoneTel}">📞 ${BUSINESS.phoneDisplay}</a>
 </div>
 <div class="wr-card featured">
 <div class="wr-badge">Most Popular</div>
 <div class="wr-icon">👥</div>
 <div class="wr-type">Studio Two Queen</div>
 <div class="wr-price wr-price-call">Call for Price</div>
 <div class="wr-period">7-night weekly rate</div>
 <a href="tel:${BUSINESS.phoneTel}">📞 ${BUSINESS.phoneDisplay}</a>
 </div>
 <div class="wr-card">
 <div class="wr-icon">🐾</div>
 <div class="wr-type">Pet-Friendly Rooms</div>
 <div class="wr-price wr-price-call">Call for Price</div>
 <div class="wr-period">7-night weekly rate</div>
 <a href="tel:${BUSINESS.phoneTel}">📞 ${BUSINESS.phoneDisplay}</a>
 </div>
 </div>

 <!-- STRUCTURED RATES TABLE — for AI extraction and featured snippets.
      Nightly prices read from RATES.nightly (confirmed 2026-09-03). The weekly
      column is deliberately "Call for price" on every row: the hotel quotes
      weekly stays by phone, and this table is exactly the surface an assistant
      would scrape a stale number off. -->
 <div class="rates-table-wrap">
 <table class="rates-table" aria-label="Room Rates — Best Western Vernal Hotel Utah">
 <thead>
 <tr>
 <th>Room Type</th>
 <th>Sleeps</th>
 <th>Nightly Rate</th>
 <th>Weekly Rate</th>
 <th>Best For</th>
 </tr>
 </thead>
 <tbody>
 <tr>
 <td>${rateCell('Studio Queen')}</td>
 <td>—</td>
 <td><span class="rate-price">${usd(RATES.nightly.studioQueen)}</span><div class="rate-note">${RATES.taxNote}</div></td>
 <td>Call for price</td>
 <td>Couples, solo travelers, longer stays</td>
 </tr>
 <tr>
 <td>${rateCell('Studio King')}</td>
 <td>1–2</td>
 <td><span class="rate-price">${usd(RATES.nightly.studioKing)}</span><div class="rate-note">${RATES.taxNote}</div></td>
 <td>Call for price</td>
 <td>Business travelers, couples</td>
