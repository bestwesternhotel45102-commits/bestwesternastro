<!-- LIGHTBOX -->
<div id="lb">
 <button id="lbclose" onclick="cl()">✕</button>
 <button class="lbn" id="lbprev" onclick="ln(-1)">‹</button>
 <img id="lb-img" src="" alt="">
 <p id="lb-cap"></p>
 <button class="lbn" id="lbnext" onclick="ln(1)">›</button>
 <div class="lbcount" id="lbc"></div>
</div>`;
const pageScripts = `<script>
// Hero Slideshow — Ken Burns backgrounds
/* ── Hero room reel ──
   Two property shots then one slide per room type. The rate card layer is a
   separate stack of <article>s keyed by data-slide, so the price cross-fades in
   step with the photo without being re-rendered. Autoplay pauses on hover, on
   focus, and while the tab is hidden. */
const slides  = document.querySelectorAll('.hero-slide');
const dc      = document.getElementById('hdots');
const rooms   = document.querySelectorAll('.hroom');
const heroEl  = document.getElementById('hero');
const hlabels = ${JSON.stringify(HERO_SLIDES.map((s) => s.label))};
const hstill  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const hfirst  = ${JSON.stringify(HERO_SLIDES[0].image)};
/* A phone hero is a 100vh box at about 0.46:1 and cover-cropping a landscape
   photograph into it keeps only ~a third of its width, so below 3:4 the reel
   serves 9:16 versions instead. Slide 0 is switched by the <style> in the head
   rather than here, so it needs no JavaScript to paint the right one. */
const hportrait = window.matchMedia('(max-aspect-ratio: 3/4)');
/* The scale a slide starts its Ken Burns from. Below 3:4 the stage is sized to
   the 9:16 frames themselves (global.css), so the photograph fits it exactly
   and ANY scale above 1 is the side-crop coming straight back — 8% of it, on a
   frame that was chosen for this shape. Read at slide time, not once at load,
   so a rotation mid-reel gets the right one. */
const hkbFrom = () => (hportrait.matches ? 1 : 1.08);
/* Milliseconds a hero slide holds. 6000 -> 4200 -> 3000: this reel opens on two
   property shots before it reaches a single room, so at 6s a guest waited 12s
   to see the first rate and now waits 6s. Still twice the room pages' 1500ms on
   purpose — a slide here carries a rate card to read, not just a photograph,
   and 3000 is about the floor for that: below it the price stops being
   readable before it is replaced.
   Three things are paired to it and must move with it: the .hero-slide and
   .hroom cross-fades in global.css, and HOME_KB_MS just below. */
const HOME_HERO_MS = 3000;
/* The OPENING slide's hold, counted from the moment its photograph is on screen
   (hbegin below). Shorter than HOME_HERO_MS because the reason for that 3000ms
   floor — reading a rate card before it is replaced — does not apply: slide 0
   is a property shot with no price on it.
   Measured before this existed, the first change came 3.7s after opening on a
   normal connection and 6.3s (phone) to 8.0s (desktop) on Slow 4G, because it
   was photo-arrival + the full 3000. That read as a page that had not started,
   and on a phone it read as frozen outright: the Ken Burns zoom is off below
   3:4 (a matched 9:16 stage turns any zoom back into crop), so nothing on the
   opening slide moves at all until the reel does. Every later slide still
   holds HOME_HERO_MS. */
const HOME_FIRST_HOLD_MS = 1500;
/* The Ken Burns drift is deliberately longer than the hold — it is a slow
   push that gets interrupted by the next slide, never a move that finishes.
   Scaled with the hold (8000 x 3000/6000) so each slide still shows the same
   share of the drift as it did at 6s rather than visibly less of it. */
const HOME_KB_MS = 4000;
let cs = 0;
let htimer = null;

if (slides.length && dc) {
  slides.forEach((_, i) => {
    const d = document.createElement('button');
    d.type = 'button';
    d.className = 'hdot' + (i === 0 ? ' active' : '');
    d.setAttribute('role', 'tab');
    d.setAttribute('aria-label', hlabels[i] || ('Slide ' + (i + 1)));
    d.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
    d.onclick = () => { gs(i); hrestart(); };
    dc.appendChild(d);
  });
}

/* Show the rate card belonging to slide n, if that slide has one. Hidden cards
   keep their CTA out of the tab order — it is a real phone link, not decoration. */
function hcard(n) {
  let shown = false;
  rooms.forEach(c => {
    const on = Number(c.dataset.slide) === n;
    if (on) shown = true;
    c.classList.toggle('active', on);
    c.setAttribute('aria-hidden', on ? 'false' : 'true');
    const cta = c.querySelector('.hroom-cta');
    if (cta) cta.tabIndex = on ? 0 : -1;
  });
  if (heroEl) heroEl.classList.toggle('hero-has-room', shown);
}

function gs(n) {
  /* The one being shown and the one after it: dots and arrows can jump
     anywhere in the reel, not only forward one. */
  hpromote(n);
  hpromote((n + 1) % slides.length);
  slides[cs].classList.remove('active');
  dc.children[cs].classList.remove('active');
  dc.children[cs].setAttribute('aria-selected', 'false');
  cs = n;
  slides[cs].classList.add('active');
  dc.children[cs].classList.add('active');
  dc.children[cs].setAttribute('aria-selected', 'true');
  hcard(cs);
  const kb = slides[cs].querySelector('.hero-kb');
  if (hstill) { kb.style.transition = 'none'; kb.style.transform = 'scale(1)'; return; }
  kb.style.transition = 'none';
  kb.style.transform  = 'scale(' + hkbFrom() + ')';
  kb.offsetHeight;
  kb.style.transition = 'transform ' + (HOME_KB_MS / 1000) + 's ease-out';
  kb.style.transform  = 'scale(1)';
}

/* Slides after the first carry their photograph in data-bg rather than in a
   style attribute, so the browser does not open seven large downloads at once
   and leave the opening frame — the only one on screen — competing with six
   that are not. This turns one back into a real background-image. */
function hpromote(n) {
  const s = slides[n];
  if (!s) return;
  const kb = s.querySelector('.hero-kb');
  if (!kb || !kb.dataset.bg) return;
  /* Hands BOTH frames to CSS, which picks between them by media query
     (global.css, beside .hero-kb). This used to pick here, once — "at promotion
     time" — and then delete the other option. But slide 1 is promoted the
     moment the page loads and the rest on idle, so in practice the choice was
     made at load and never revisited: a page opened wide and then narrowed
     (a resized window, DevTools device mode, a phone turned upright) kept the
     landscape frame on every slide after the first, cover-cropped into a 9:16
     stage. Slide 0 never had the problem because the head <style> already let
     CSS choose. Now every slide works the way slide 0 does.
     Nothing extra downloads: a browser fetches only the background-image that
     applies at the current viewport, and the other only if the viewport
     actually changes. A slide with no portrait falls back to its landscape
     frame in the CSS.
     THE LEADING SLASH IS LOAD-BEARING. A relative url() inside a custom
     property is resolved against the STYLESHEET that consumes it via var() —
     global.css, served from /_astro/ — not against this page. Without the "/"
     every slide after the first requested /_astro/images/… and 404'd to a
     blank grey stage. rooms/[slug].astro sets its --rm-bg the same way for the
     same reason. */
  kb.style.setProperty('--hbg', "url('/" + kb.dataset.bg + "')");
  if (kb.dataset.bgPortrait) kb.style.setProperty('--hbg-p', "url('/" + kb.dataset.bgPortrait + "')");
  kb.removeAttribute('data-bg');
  kb.removeAttribute('data-bg-portrait');
}

function hstep(d)  { gs((cs + d + slides.length) % slides.length); }
function hstop()   { clearInterval(htimer); htimer = null; }
function hstart()  { if (!htimer && slides.length > 1) htimer = setInterval(() => hstep(1), HOME_HERO_MS); }
function hrestart(){ hstop(); hstart(); }

if (slides.length) {
  hcard(0);
  document.getElementById('hprev')?.addEventListener('click', () => { hstep(-1); hrestart(); });
  document.getElementById('hnext')?.addEventListener('click', () => { hstep(1);  hrestart(); });
  if (heroEl) {
    heroEl.addEventListener('mouseenter', hstop);
    heroEl.addEventListener('mouseleave', hstart);
    heroEl.addEventListener('focusin',  hstop);
    heroEl.addEventListener('focusout', hstart);
  }
  document.addEventListener('visibilitychange', () => { document.hidden ? hstop() : hstart(); });

  const kb0 = slides[0].querySelector('.hero-kb');
  /* Was a hardcoded 8s, left behind when the reel's timings became constants. */
  kb0.style.transition = hstill ? 'none' : 'transform ' + (HOME_KB_MS / 1000) + 's ease-out';
  kb0.style.transform  = 'scale(1)';

  /* Do not start counting until the opening photograph is actually on screen.
     The timer was always exact — measured, it fired at 3269, 6270 and 9270ms —
     but on anything slower than localhost the first two of those were spent on
     a frame with no picture in it yet, so the reel appeared to sit still and
     then race. A hold is meant to be 3s of a guest LOOKING at a room. */
  let hbegun = false;
  function hbegin() {
    if (hbegun) return;
    hbegun = true;
    hpromote(1);            // ready the frame the first advance will show
    /* First advance after HOME_FIRST_HOLD_MS, then the normal HOME_HERO_MS
       rhythm. The one-shot lives in htimer, so hover, focus and a hidden tab
       still cancel it through hstop() — clearInterval clears a setTimeout id
       too (the HTML spec keeps one timer list for both) — and hstart()'s
       !htimer guard then resumes at the normal hold. */
    if (!htimer && slides.length > 1) {
      htimer = setTimeout(() => { htimer = null; hstep(1); hstart(); }, HOME_FIRST_HOLD_MS);
    }
    /* The rest once the page has settled — none is needed for 6s yet. */
    const rest = () => { for (let i = 2; i < slides.length; i++) hpromote(i); };
    if (document.readyState === 'complete') setTimeout(rest, 0);
    else window.addEventListener('load', () => setTimeout(rest, 300), { once: true });
  }
  const probe = new Image();
  probe.onload = hbegin;
  probe.onerror = hbegin;   // a missing photograph must not stop the reel
  probe.src = (hportrait.matches && ${JSON.stringify(HERO_SLIDES[0].portrait ?? '')}) || hfirst;
  if (probe.complete) hbegin();
  setTimeout(hbegin, 5000); // and neither must a slow one
}

// Room Tabs
function st(btn,id){
  document.querySelectorAll('.tpanel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tbtn').forEach(b=>b.classList.remove('active'));
  document.getElementById('t-'+id).classList.add('active');
  btn.classList.add('active');
}

// Lightbox. The array is emitted from HOME_GALLERY, the same list the grid
// above renders, so a tile's ola(i) and imgs[i] are the same picture by
// construction. They were two hand-kept lists and had drifted: every room tile
// opened a different photograph. Do not re-inline this.
const imgs=${JSON.stringify(HOME_GALLERY.map((t) => ({ s: t.src, c: t.label })))};
let li=0;
/* solo holds a picture opened from somewhere OTHER than the gallery grid — the
   room tabs in #rooms call ol() with their own files, which are not in imgs.
   ol() used to findIndex and fall back to index 0 on a miss, so any such card
   opened the FIRST GALLERY PICTURE instead of the room you clicked. Now a miss
   shows the picture it was actually given, with the counter and the arrows
   stood down because a single picture has no sequence to step through. */
let solo=null;
function lbopen(){document.getElementById('lb').classList.add('open');document.body.style.overflow='hidden';}
function ola(i){solo=null;li=i;sl();lbopen();}
function ol(s,c){const i=imgs.findIndex(x=>x.s===s);if(i>=0){solo=null;li=i;}else{solo={s:s,c:c};}sl();lbopen();}
function sl(){
  const img=document.getElementById('lb-img');
  const it=solo||imgs[li];
  img.style.opacity=0;
  setTimeout(()=>{img.src=it.s;document.getElementById('lb-cap').textContent=it.c;document.getElementById('lbc').textContent=solo?'':(li+1)+' / '+imgs.length;img.style.opacity=1;},150);
}
function ln(d){if(solo)return;li=(li+d+imgs.length)%imgs.length;sl();}
function cl(){document.getElementById('lb').classList.remove('open');document.body.style.overflow='';}
document.getElementById('lb')?.addEventListener('click',function(e){if(e.target===this)cl();});
document.addEventListener('keydown',e=>{
  const lb=document.getElementById('lb');
  if(!lb||!lb.classList.contains('open'))return;
  if(e.key==='ArrowRight')ln(1);
  if(e.key==='ArrowLeft')ln(-1);
  if(e.key==='Escape')cl();
});

/* ── Owner Video Frame — YouTube embed ── */
const ownerOverlay = document.getElementById('ownerPlayOverlay');
const ownerIframe  = document.getElementById('ownerVideo');

if (ownerOverlay && ownerIframe) {
  ownerOverlay.addEventListener('click', () => {
    ownerIframe.contentWindow.postMessage(
      '{"event":"command","func":"playVideo","args":""}', '*'
    );
    ownerOverlay.style.opacity = '0';
    ownerOverlay.style.pointerEvents = 'none';
  });

  if (window.matchMedia('(hover: hover)').matches) {
    const ownerBox = document.getElementById('ownerFrameBox');
    const scene    = ownerBox.closest('.owner-frame-scene');
    scene.addEventListener('mousemove', e => {
      const r    = scene.getBoundingClientRect();
      const x    = (e.clientX - r.left)  / r.width  - 0.5;
      const y    = (e.clientY - r.top)   / r.height - 0.5;
      const rotY =  x * 14;
      const rotX = -y * 14;
      ownerBox.style.transform = \`rotateX(\${rotX}deg) rotateY(\${rotY}deg)\`;
    });
    scene.addEventListener('mouseleave', () => {
      ownerBox.style.transform = 'rotateX(2deg) rotateY(2deg)';
    });
  }
}
</script>
<script>
/* Google review button (under the guest quote): a burst of stars on click.
   The link still opens normally. Skipped under reduced motion. */
(() => {
  const btn = document.querySelector('.quote .bw-review-btn');
  if (!btn) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  btn.addEventListener('click', () => {
    for (let i = 0; i < 10; i++) {
      const s = document.createElement('span');
      s.className = 'bw-review-btn__spark';
      s.setAttribute('aria-hidden', 'true');
      s.textContent = '★';
      const angle = (Math.PI * 2 * i) / 10 + Math.random() * 0.4;
      const dist = 40 + Math.random() * 30;
      s.style.setProperty('--dx', Math.cos(angle) * dist + 'px');
      s.style.setProperty('--dy', Math.sin(angle) * dist + 'px');
      btn.appendChild(s);
      s.addEventListener('animationend', () => s.remove());
      setTimeout(() => s.remove(), 1000); // fallback if animations are paused
    }
  });
})();
</script>`;
